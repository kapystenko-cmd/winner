# ocinka.pro — змінні середовища
# Скопіюйте як .env і заповніть реальними значеннями

# === База даних ===
DATABASE_URL=postgresql+asyncpg://ocinka:YOUR_DB_PASSWORD@localhost:5432/ocinka

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
SECRET_KEY=your-secret-key-change-this-to-random-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Gemini Vision (OCR документів) ===
GEMINI_API_KEY=your-gemini-api-key

# === Claude Sonnet (fallback для складних сканів) ===
ANTHROPIC_API_KEY=your-anthropic-api-key

# === DeepSeek (генерація тексту звіту) ===
DEEPSEEK_API_KEY=your-deepseek-api-key

# === DIM.RIA API (аналоги) ===
DIMRIA_API_KEY=your-dimria-api-key
# true після придбання/активації ліміту DIM.RIA
DIMRIA_ENABLED=true

# === ZenRows (скриншоти + OLX парсинг) ===
ZENROWS_API_KEY=your-zenrows-api-key

# === Brevo (email) ===
BREVO_API_KEY=your-brevo-api-key

# === LemonSqueezy (платежі) ===
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# === Шляхи зберігання ===
UPLOAD_DIR=/var/lib/ocinka/uploads
GENERATED_DIR=/var/lib/ocinka/generated
SCREENSHOTS_DIR=/var/lib/ocinka/screenshots

# === Sentry (моніторинг помилок) ===
SENTRY_DSN=

# === Адмін ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
