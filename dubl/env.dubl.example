# dubl.top — змінні середовища.
# Скопіюй як .env.dubl у робочу теку сервісу (/opt/dubl.top/.env.dubl)
# і впиши реальні значення. Ключі ті самі, що в ocinka, але окрема копія.

# === Gemini (аналіз скриншота) ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# === ZenRows (обхід сайтів/OLX — для наступних етапів) ===
ZENROWS_API_KEY=

# === DIM.RIA API (зріз цін — для наступних етапів) ===
DIMRIA_API_KEY=
DIMRIA_ENABLED=false

# === Google Places API (New) — карта агентств по місту (M2) ===
GOOGLE_PLACES_API_KEY=

# === Сервіс ===
PORT=8020
CORS_ORIGINS=https://dubl.top,https://www.dubl.top

# === Параметри пошуку ===
AREA_TOLERANCE=0.10
MIN_PHOTO_MATCHES=2
# Нічого не зберігаємо на диск, крім каталогу посилань агентств.
